# Required: default writer and LLM classifier. Key: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=
# Recommended: TypeSafe Jev router (without it, the LLM classifier routes alone). Key: https://console.typesafe.ai/
TYPESAFE_API_KEY=
# Optional: --writer gemini. Key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional: --writer qwen (free tier: 50 requests/day). Key: https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Optional: self-hosted Laya (TypeSafe-compatible /v1/systemone)
LAYA_URL=
# Optional: export traces to Phoenix (docker compose up -d phoenix)
PHOENIX_COLLECTOR_ENDPOINT=
